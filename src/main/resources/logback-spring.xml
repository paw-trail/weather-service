<?xml version="1.0" encoding="UTF-8"?>
<!--
  로깅 설정임

  파일 이름이 반드시 logback-spring.xml 이어야 함
  logback.xml 로 두면 스프링 확장이 걸리지 않아 <springProfile> 과 <springProperty> 가
  오류 없이 조용히 무시됨

  *<springProfile> 은 최상위에만 둘 수 있음
    <root>·<appender>·<logger> 안에 넣으면 아래 경고가 뜨고 동작이 보장되지 않음
      <springProfile> elements cannot be nested within an <appender>, <logger> or <root> element
    logback 은 <springProfile> 을 먼저 처리하는데 <root> 안쪽은 나중에 처리하므로
    평가 시점이 어긋나기 때문임
    따라서 프로파일마다 <root> 를 따로 두는 것이 지원되는 형태임

  구조
    콘솔 appender 는 Boot 기본 설정(defaults.xml)을 가져다 씀
    LOKI appender 는 공통 모듈 jar 의 logback-loki-appender.xml 에서 가져옴
-->
<configuration>

    <!-- Boot 이 제공하는 기본 변수와 콘솔 appender 정의임 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!--
      application.yml 의 값을 logback 변수로 끌어옴
      *include 보다 먼저 선언해야 공통 모듈 쪽 XML 에서 참조할 수 있음
    -->
    <springProperty name="appName" source="spring.application.name" defaultValue="unknown"/>
    <springProperty name="lokiUrl" source="app.logging.loki.url"
                    defaultValue="http://localhost:3100/loki/api/v1/push"/>

    <!--
      local 은 IntelliJ 에서 도는 경우임
      Loki 로 보내지 않으므로 appender 정의를 include 하지도 않음
    -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- local 이 아닌 경우는 컨테이너에서 도는 경우임 -->
    <springProfile name="!local">

        <!-- 공통 모듈 jar 안의 LOKI appender 정의임 -->
        <include resource="logback-loki-appender.xml"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>

    </springProfile>

</configuration>
